// goose-ported basecase (F0929) legality: the self-call is NOT in return
// position (`return 1 + f(n - 1);`) — inlining the base case there would
// drop the + 1 of the leaf call.  The pass must leave the function alone
// (no F0929); the program must still compile and run.
fn f(n: i64) -> i64 {
    if n <= 0 { return 0; }
    return 1 + f(n - 1);
}

fn main() {
    print_i64(f(5)); println();   // 5
}
