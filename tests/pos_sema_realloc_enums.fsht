// fsht-data crash regression: semaProgram's enum variant payload
// binding loop used a range-for over p->enums while binding a
// payload type APPENDS instantiations (Option<T>/Result<T,E>) to
// p->enums — push_back past capacity reallocates and the cached
// iterators walk freed memory (pinContextTo segfault).  Exactly
// 512 enums (a power-of-two capacity boundary) make the
// Option<i64> instantiation the 513th push — a deterministic
// realloc on the pre-fix build.
enum E0 { W(Option<i64>), Done }
enum E1 { W(i64), Done }
