// fsht tooling (registry 07.04.01): the `export fn` surface every
// --emit-c-header consumer sees.  The program itself is a normal binary
// (its main prints the same values the C consumer asserts against).
struct Particle { x: f64, y: f64, mass: f64 }
enum Shape { Circle(f64), Rect(f64, f64), Point }

export fn fib(n: i64) -> i64 {
    if (n < 2) { return n; }
    return fib(n - 1) + fib(n - 2);
}

export fn kinetic(p: Particle) -> f64 {
    return 0.5 * p.mass * (p.x * p.x + p.y * p.y);
}

export fn area(s: Shape) -> f64 {
    match (s) {
        Circle(r) => { return 3.0 * r * r; }
        Rect(w, h) => { return w * h; }
        Point => { return 0.0; }
    }
}

export fn sum_span(v: Span<f64>) -> f64 {
    let mut t: f64 = 0.0;
    for (i = 0; i < v.len; i += 1) {
        t = t + v[i];
    }
    return t;
}

fn main() {
    let p: Particle = Particle { x: 3.0, y: 4.0, mass: 2.0 };
    print_f64(kinetic(p), 1); println();          // 25.0
    print_f64(area(Circle(2.0)), 1); println();   // 12.0
    print_f64(area(Rect(2.5, 4.0)), 1); println(); // 10.0
    let vals: [f64; 4] = [1.0, 2.0, 3.0, 4.0];
    print_f64(sum_span(span(vals)), 1); println(); // 10.0
    print_i64(fib(20)); println();                // 6765
}
