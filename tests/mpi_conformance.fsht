// hybrid MPI + parfor
// conformance.  The registry defers GPU/MPI to separate runtime
// integrations rather than language surface, so the near-term contract
// is exactly this shape: `extern fn` MPI calls BETWEEN parfor regions
// work, and the runtime's idle pool workers never interfere with MPI
// progress (workers sleep on the queue condition; the main thread's MPI
// calls own the process between regions).
//
// Run under a real MPI host through tests/mpi_check.sh:
//     mpirun -np 4 ./mpi_conformance
// Rank 0 computes a seed; Bcast distributes it; every rank runs a
// parfor over its local span; Allreduce sums the partials; the result
// must equal the closed-form total for ANY rank count.
#link mpi

// MPI-3 ABI (C integers; the handles are opaque ints to Freshet)
extern fn MPI_Init(argc: *i32, argv: *i32) -> i32;
extern fn MPI_Comm_rank(comm: i32, rank: *i32) -> i32;
extern fn MPI_Comm_size(comm: i32, size: *i32) -> i32;
extern fn MPI_Bcast(buf: *i64, count: i32, dt: i32, root: i32,
                    comm: i32) -> i32;
extern fn MPI_Allreduce(send: *f64, recv: *f64, count: i32, dt: i32,
                        op: i32, comm: i32) -> i32;
extern fn MPI_Finalize() -> i32;

fn main() {
    let mut rc: i32 = MPI_Init(nil as *i32, nil as *i32);
    if (rc != 0) { print("MPI_Init failed"); println(); return; }

    let mut rank: i32 = 0;
    let mut size: i32 = 0;
    let comm_world: i32 = 0x44000000;   // MPI_COMM_WORLD
    let mpi_long: i32 = 7;               // MPI_LONG
    let mpi_double: i32 = 8;             // MPI_DOUBLE
    let mpi_sum: i32 = 5;                 // MPI_SUM (op handle, portable
                                          // via the builtin ops' enum)
    let mut stat: i32 = MPI_Comm_rank(comm_world, &mut rank);
    stat = MPI_Comm_size(comm_world, &mut size);
    if (size < 1) { print("bad size"); println(); return; }

    // 1) Bcast BEFORE any parfor: rank 0 publishes the seed
    let mut seed: i64 = 0;
    if (rank == 0) { seed = 64; }
    stat = MPI_Bcast(&mut seed, 1, mpi_long, 0, comm_world);

    // 2) a parfor region on every rank (the pool spins up here)
    let n: u64 = 64;
    let local: *f64 = malloc(f64, n);
    defer free(local);
    for (i in 0..n) { local[i] = 0.0; }
    parfor (i in 0..n) {
        local[i] = (seed as f64) * 0.25;   // 16.0 per element
    }

    // 3) an MPI collective BETWEEN two parfor regions: the workers are
    //    idle during Allreduce — the conformance point (they must sleep
    //    on the queue condition, never spin MPI or the CPU)
    let mut total: f64 = 0.0;
    let mut p: f64 = 0.0;
    for (i in 0..n) { p = p + local[i]; }
    stat = MPI_Allreduce(&mut p, &mut total, 1, mpi_double, mpi_sum,
                         comm_world);

    // 4) one more parfor AFTER the collective (pool re-entrance)
    parfor (i in 0..n) {
        local[i] = 1.0;
    }
    let mut q: f64 = 0.0;
    for (i in 0..n) { q = q + local[i]; }

    // expected: total = 16.0 * 64 * size; q = 64
    print("rank "); print_i64(rank as i64);
    print(" total "); print_f64(total, 2);
    print(" expect "); print_f64(1024.0 * (size as f64), 2);
    print(" after "); print_f64(q, 2); println();

    stat = MPI_Finalize();
    if (rank == 0) {
        print("MPI_CONFORMANCE_OK"); println();
    }
}
