// fsht-data crash fix regression (module side): libc_a and libc_b both
// extern-declare the SAME C symbols with the same signature — two modules,
// one @fopen.  Every imported FnDecl used to emit its own `declare` line
// and LLVM rejects any second declaration of a symbol, identical or not,
// so the build died with "invalid redefinition of function 'fopen'"
// before the runtime half even entered the module.  The IR generator now
// folds identical re-declarations into exactly one declare per C symbol.
module libc_a;

pub extern fn fopen(path: *u8, mode: *u8) -> *u8;
pub extern fn fclose(f: *u8) -> i32;
pub extern fn fputs(s: *u8, f: *u8) -> i32;

pub fn write_line(path: str, text: str) -> i32 {
    // separate lets for the C strings: two str_to_cstr results share a
    // call-name root, and fopen's params are noalias by contract
    let p: *u8 = str_to_cstr(path);
    let m: *u8 = str_to_cstr("w");
    let s: *u8 = str_to_cstr(text);
    let f: *u8 = fopen(p, m);
    fputs(s, f);
    return fclose(f);
}
