// goose-ported data stacks (F0925): stack_alloc bumps a per-thread,
// pre-reserved region and dies with its scope (watermark restore — no
// free()).  Sequential scopes REUSE the same memory (indices released at
// block end): reuse's 1000 loop-scoped bumps cycle ONE index, and each
// callee's stacks sit above the caller's in use at the call — main calls
// both with nothing in use, so the program needs N = 1.
fn work(n: usize, seed: f64) -> f64 {
    let scratch: *f64 = stack_alloc(f64, n);
    for (i in 0..n) { scratch[i] = (i as f64) * seed; }
    let mut t: f64 = 0.0;
    for (i in 0..n) { t += scratch[i]; }
    return t;   // scratch dies here
}

fn reuse(n: usize) -> f64 {
    let mut t: f64 = 0.0;
    for (r in 0..1000) {
        let b: *f64 = stack_alloc(f64, n);
        for (i in 0..n) { b[i] = 1.0; }
        t = t + b[n - 1];
    }
    return t;
}

fn main() {
    let n: usize = 100;
    print_f64(work(n, 0.5), 2); println();     // 2475.00
    print_f64(reuse(n), 2); println();         // 1000.00
}
