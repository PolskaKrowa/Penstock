// numeric — numeric traits and common algorithms (fsht-03:01,
// ch. 23 §5): the checked/saturating/wrapping variant family, the
// conversion facilities and abs/gcd/clamp.
//
// The §2/§3 builtins are compiler-known (usable without import, the
// fmt_* precedent) and re-exported here; checked_cast/saturating_cast
// infer their destination U from the context, so they are NOT wrapped
// (a wrapper could not forward the inference) — the builtins serve
// both spellings (`checked_add` / `numeric::checked_add`).
module numeric;

pub fn checked_add(a: i64, b: i64) -> Option<i64> {
    return checked_add(a, b);
}

pub fn saturating_add(a: i64, b: i64) -> i64 {
    return saturating_add(a, b);
}

pub fn wrapping_add(a: i64, b: i64) -> i64 {
    return wrapping_add(a, b);
}

pub fn abs(x: i64) -> i64 {
    return abs(x);
}

pub fn gcd(a: i64, b: i64) -> i64 {
    return gcd(a, b);
}

pub fn clamp(x: i64, lo: i64, hi: i64) -> i64 {
    return clamp(x, lo, hi);
}
